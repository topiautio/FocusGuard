[Unit]
Description=FocusGuard website blocker
After=network-online.target NetworkManager.service nftables.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/focusguard/.venv/bin/focusguard-daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
User=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
RuntimeDirectory=focusguard
ReadWritePaths=/etc/NetworkManager/dnsmasq.d /etc/nftables.d /var/lib/focusguard /var/log/focusguard

[Install]
WantedBy=multi-user.target
